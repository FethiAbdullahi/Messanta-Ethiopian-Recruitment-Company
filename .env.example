# Public site URL for email links (include https). Optional: VERCEL_URL is used on Vercel if unset.
NEXT_PUBLIC_SITE_URL=https://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: owner email promoted to super_admin on sign-in / API sync (default: skillsforlifeethio@gmail.com). Needs service role key. POST /api/auth/sync-profile repairs missing profiles rows.
BOOTSTRAP_SUPER_ADMIN_EMAIL=skillsforlifeethio@gmail.com

# Migrations promote skillsforlifeethio@gmail.com to super_admin when that auth user exists.
# Password reset: in Supabase Dashboard → Authentication → URL configuration, add redirect URLs:
#   http://localhost:3000/auth/callback  and  http://localhost:3000/auth/reset-password
#   plus your production origin with the same paths.

# WhatsApp (optional override; default in app is +251 955 88 88 85)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Enrollment emails via Resend (https://resend.com) — sends trainee confirmation + admin copy with full form
RESEND_API_KEY=
RESEND_FROM_EMAIL="Skills for Life <onboarding@yourdomain.com>"
# Admin receives new enrollment details (default: skillsforlifeethio@gmail.com)
ADMIN_NOTIFICATION_EMAIL=skillsforlifeethio@gmail.com

# Optional: enrollment confirmation SMS (https://www.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
